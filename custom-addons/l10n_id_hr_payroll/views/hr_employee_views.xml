<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_employee_form_l10n_id_payroll" model="ir.ui.view">
        <field name="name">hr.employee.form.l10n_id.payroll</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form" />
        <field name="arch" type="xml">
            <xpath expr="//form/sheet/notebook" position="inside">
                <page string="Payroll Indonesia" name="l10n_id_payroll">
                    <group>
                        <group string="Pajak (PPh 21)">
                            <field name="l10n_id_npwp" />
                            <field name="l10n_id_ptkp_status" />
                        </group>
                        <group string="BPJS">
                            <field name="l10n_id_bpjs_kesehatan_no" />
                            <field name="l10n_id_bpjs_tk_no" />
                            <field name="l10n_id_jkk_rate" />
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>